<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Weekly iCloud Photos export to New_Data. Install: see backup/README.md -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jbakse.photos-export</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/jbakse/dotfiles/backup/photos-export.sh</string>
  </array>
  <!-- Sunday 1:00. If the Mac is asleep then, launchd runs it at the next wake. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>0</integer>
    <key>Hour</key>
    <integer>1</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/jbakse/Library/Logs/photos-export.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jbakse/Library/Logs/photos-export.log</string>
</dict>
</plist>
